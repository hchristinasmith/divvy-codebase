{
  "name": "divvy",
  "type": "module",
  "version": "0.1.0",
  "main": "server/index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "npm run migrate:latest && node dist/server.js",
    "dev": "run-p dev:client dev:server",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "run-s build:client build:server build:mcp",
    "build:client": "vite build",
    "build:server": "esbuild --packages=external --platform=node --format=esm --outfile=dist/server.js --bundle server/index.ts",
    "build:mcp": "esbuild --packages=external --platform=node --format=esm --bundle --loader:.sql=text --outfile=dist/mcp/index.js mcp/index.ts && esbuild --packages=external --platform=node --format=esm --bundle --outfile=dist/mcp/refresh.js mcp/replica/refresh-cli.ts && cp mcp/audit/schema.sql dist/mcp/schema.sql",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx .",
    "typecheck": "tsc --noEmit",
    "knex": "knex --knexfile ./server/db/knexfile.js",
    "migrate:create": "knex --knexfile ./server/db/knexfile.js migrate:make",
    "migrate:latest": "knex --knexfile ./server/db/knexfile.js migrate:latest",
    "migrate:rollback": "knex --knexfile ./server/db/knexfile.js migrate:rollback"
  },
  "eslintConfig": {
    "root": true,
    "extends": "@devacademy/eslint-config/react",
    "ignorePatterns": [
      "bundle.js",
      "dist/",
      "docs/"
    ],
    "overrides": [
      {
        "files": [
          "mcp/**/*.ts",
          "mcp/**/*.tsx",
          "mcp/**/*.js",
          "mcp/**/*.mjs",
          "mcp/**/*.cjs"
        ],
        "rules": {
          "no-restricted-imports": [
            "error",
            {
              "patterns": [
                {
                  "group": [
                    "**/server",
                    "**/server/**",
                    "@/**",
                    "!@modelcontextprotocol/**"
                  ],
                  "message": "mcp/ must not import server/ (prd-03 Ruling 6); it reads only the scrubbed replica."
                }
              ]
            }
          ],
          "no-console": [
            "error",
            {
              "allow": [
                "error",
                "warn"
              ]
            }
          ]
        }
      }
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "express": "^4.17.2",
    "knex": "^2.5.1",
    "lucide-react": "^0.511.0",
    "sqlite3": "^5.1.6",
    "superagent": "^10.2.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@devacademy/eslint-config": "^1.10.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@tanstack/eslint-plugin-query": "^5.12.2",
    "@tanstack/react-query": "^5.12.2",
    "@tanstack/react-query-devtools": "^5.13.3",
    "@testing-library/react": "^14.0.0",
    "@types/express": "^4.17.14",
    "@types/node": "^22.15.29",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@types/superagent": "^8.1.1",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "esbuild": "^0.18.19",
    "eslint": "^8.56.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^22.1.0",
    "npm-run-all": "^4.1.5",
    "react": "^18.0.2",
    "react-dom": "^18.2.0",
    "react-router": "^7.6.1",
    "supertest": "^6.3.4",
    "tailwindcss": "^4.1.8",
    "tsx": "^3.12.7",
    "tw-animate-css": "^1.3.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.0",
    "vitest": "^1.2.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  },
  "browserslist": "> 2%, not dead"
}
