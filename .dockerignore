# Keep the build context to what the image needs. node_modules in particular
# must never be copied in: sqlite3 is a native module, and the host's build
# (macOS) does not run in the Linux image.
node_modules
dist
.git
.vscode
coverage
*.log

# Secrets and data never enter an image (CLAUDE.md, Security).
.env
.env.*
*.sqlite3
spending.js
