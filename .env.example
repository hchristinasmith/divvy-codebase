# Copy to .env and fill in. Never commit .env.

# Akahu personal-app credentials (read by server/routes/akahu.ts)
AKAHU_USER_TOKEN=
AKAHU_APP_ID=

# Express port (server/index.ts); the Vite dev proxy expects 3005
PORT=3005

# Interface the Express server listens on (server/index.ts). Blank or unset means 127.0.0.1 (loopback only, D4); production sets it for Fly (#22).
HOST=

# Selects the knex environment in server/db/connection.ts: development | test | production
NODE_ENV=development
