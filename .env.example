# Copy to .env and fill in. Never commit .env.

# Akahu personal-app credentials (read by server/routes/akahu.ts and server/sync/scheduler.ts (at the start of each sync run))
AKAHU_USER_TOKEN=
AKAHU_APP_ID=

# Optional: milliseconds between scheduled syncs (server/sync/scheduler.ts), read when the server starts. Default 900000 (15 minutes). Digits only, 60000 to 2147483647; anything else logs a warning and uses the default.
# SYNC_INTERVAL_MS=900000

# Express port (server/index.ts); the Vite dev proxy expects 3005
PORT=3005

# Interface the Express server listens on (server/index.ts). Blank or unset means 127.0.0.1 (loopback only, D4); whether production sets it is decided by #22.
HOST=

# Selects the knex environment in server/db/connection.ts: development | test | production
NODE_ENV=development
