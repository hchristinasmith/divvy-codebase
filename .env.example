# Copy to .env and fill in. Never commit .env.

# Akahu personal-app credentials, read only by server/sync/scheduler.ts, at the start of each sync run
AKAHU_USER_TOKEN=
AKAHU_APP_ID=

# Optional: milliseconds between scheduled syncs (server/sync/scheduler.ts), read when the server starts. Unset or empty means the default, 900000 (15 minutes). Digits only, 60000 to 2147483647; any other value logs a warning and uses the default.
# SYNC_INTERVAL_MS=900000

# Claude API key for the category agent's model path (prd-04 Ruling 9), read only by server/agents/llm/config.ts, before every model call. Blank means no key: a model call refuses before the network. A Fly secret in production; it must never reach the MCP, whose entry refuses to start with any ANTHROPIC_ variable set (mcp/guard-env.ts).
ANTHROPIC_API_KEY=

# Optional: stops every model call (server/agents/llm/config.ts), read from the process environment before each call, never cached; the rules still run. Unset or blank means off. Any other value means on, 0 and false included.
# AGENT_KILL_SWITCH=1

# Optional: input and output tokens together that model calls may spend per Pacific/Auckland day (server/agents/llm/config.ts), read before each call. Unset or blank means the default, 200000. Digits only, a positive whole number; any other value logs a warning and uses the default.
# AGENT_DAILY_TOKEN_BUDGET=200000

# Express port (server/index.ts); the Vite dev proxy expects 3005
PORT=3005

# Interface the Express server listens on (server/index.ts). Blank or unset means 127.0.0.1 (loopback only, D4); never set it in production; `scripts/start.sh` refuses to boot with any value but blank or `127.0.0.1` (#22).
HOST=

# Selects the knex environment in server/db/connection.ts: development | test | production
NODE_ENV=development
